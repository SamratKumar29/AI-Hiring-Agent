# Central brain config. Copy to brain/.env and fill in. NEVER commit brain/.env.

# --- OpenRouter (required) ---
OPENROUTER_API_KEY=

# Tier 1 (free), ordered by thinking capability, best first. Probed one by one at start; first that answers is used.
OPENROUTER_MODELS=inclusionai/ling-3.1-flash,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,cohere/north-mini-code:free,liquid/lfm-2.5-2.6b:free
# Tier 2 (paid), comma-separated, ordered. Probed ONLY if every model above fails once.
OPENROUTER_PAID_FALLBACK=anthropic/claude-haiku-5.5
# Resume-Matcher needs a model with strict JSON output; these are tried first (comma separated)
RESUME_MATCHER_MODELS=xiaomi/mimo-v2.6-flash

# --- Notifications (optional; empty = skipped) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# --- Scraping (optional) ---
FIRECRAWL_API_KEY=

# --- Schedule / safety ---
DAILY_TIME=08:00
MAX_EVALS_PER_RUN=20
# Stop ranking / generating when this month's OpenRouter spend reaches this many USD (0 = no guard)
MONTHLY_SPEND_LIMIT_USD=5
